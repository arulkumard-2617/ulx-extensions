{
  "name": "ulx-extention-builder",
  "version": "1.0.0",
  "private": true,
  "description": "Blueprint for building standalone ULX extension pages with PrimeReact and Tailwind",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "node scripts/build-pages.mjs",
    "compile": "node scripts/build-pages.mjs",
    "create:page": "node scripts/create-page.mjs",
    "validate": "node scripts/validate-project.mjs",
    "check": "npm run validate && npm run build",
    "build:app": "vite build",
    "preview": "vite preview",
    "pack:zip": "node scripts/pack-zip.js"
  },
  "dependencies": {
    "primeicons": "^7.0.0",
    "primereact": "^10.9.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
